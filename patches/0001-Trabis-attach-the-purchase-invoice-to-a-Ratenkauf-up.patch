 CHANGES_FOR_BACKEND.md   |  5 ++++
 css/trabis.css           |  6 +++++
 js/13d-purchase-plans.js | 58 ++++++++++++++++++++++++++++++++++++++--
 3 files changed, 67 insertions(+), 2 deletions(-)

