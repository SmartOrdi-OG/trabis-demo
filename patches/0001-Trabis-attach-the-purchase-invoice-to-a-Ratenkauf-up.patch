@@ -94,6 +100,38 @@ function ppBook(pl, kind, date, netto, label) {
   pl.payments = pl.payments || [];
   pl.payments.push({txId: txId, date: date, netto: ppR2(netto), vat: ppR2(vat), kind: kind});
